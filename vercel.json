{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/research/evolution-of-human-skills/assets/:file*", "destination": "/assets/:file*" },
    { "source": "/research/evolution-of-human-skills/:file(.+\\.[a-z0-9]+)", "destination": "/:file" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(research/evolution-of-human-skills/)?assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
